FROM python:3.11-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && update-ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY server-b-retrieval/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY server-b-retrieval/ .
COPY shared/golden_policies_mvp.json /app/shared/golden_policies_mvp.json

ENV POLICY_DISCOVERY_PATH=/app/shared/golden_policies_mvp.json

EXPOSE 10000
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "10000"]
