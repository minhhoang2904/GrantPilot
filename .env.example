# MongoDB Atlas connection string
# Đăng ký tại https://mongodb.com/atlas → tạo cluster → Connect → Drivers
# Thay YOUR_USER, YOUR_PASSWORD, YOUR_CLUSTER bằng thông tin thật
MONGODB_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/
MONGODB_DB=grantpilot
MONGODB_DATABASE=grantpilot

# Pinecone vector database
PINECONE_API_KEY=
PINECONE_INDEX_HOST=
PINECONE_INDEX_NAME=
PINECONE_NAMESPACE=legal_units

# Local manual services. Docker Compose overrides this with its service hostname.
SERVER_C_URL=http://localhost:8002

# ---------------------------------------------------------------------------
# LLM / Embedding / Rerank — multi-provider config
#
# Each role uses its own API key and base URL so you can mix providers freely.
# Sign up for free tiers:
#   Jina AI  → https://jina.ai (embeddings + reranker, 10M tokens free)
#   Groq     → https://console.groq.com (LLMs, 14,400 req/day free)
# ---------------------------------------------------------------------------

# Embeddings (Jina AI — https://jina.ai)
EMBEDDING_API_KEY=jina_xxxxxxxxxxxx
EMBEDDING_BASE_URL=https://api.jina.ai/v1
EMBEDDING_MODEL=jina-embeddings-v3

# Reranker (Jina AI — same key as embeddings)
RERANK_API_KEY=jina_xxxxxxxxxxxx
RERANK_BASE_URL=https://api.jina.ai/v1
RERANK_MODEL=jina-reranker-v2-base-multilingual

# Query rewrite LLM (Groq — https://console.groq.com)
REWRITE_API_KEY=gsk_xxxxxxxxxxxx
REWRITE_BASE_URL=https://api.groq.com/openai/v1
REWRITE_MODEL=openai/gpt-oss-120b

# Answer generation LLM (Groq)
ANSWER_API_KEY=gsk_xxxxxxxxxxxx
ANSWER_BASE_URL=https://api.groq.com/openai/v1
ANSWER_MODEL=openai/gpt-oss-120b
ANSWER_MAX_TOKENS=8192

# Advisory suggestions (defaults to answer provider if omitted)
ADVISORY_ENABLED=true
# ADVISORY_API_KEY=
# ADVISORY_BASE_URL=
# ADVISORY_MODEL=
ADVISORY_MAX_TOKENS=1200

# Eligibility explanation LLM — Server C (defaults to answer provider if omitted)
ELIGIBILITY_LLM_ENABLED=true
# ELIGIBILITY_API_KEY=
# ELIGIBILITY_BASE_URL=
# ELIGIBILITY_MODEL=

# ---------------------------------------------------------------------------
# Legacy FPT_* variables (still supported as fallback)
# If you set these, they will be used when the new per-provider vars are empty.
# ---------------------------------------------------------------------------
# FPT_API_KEY=
# FPT_BASE_URL=https://mkp-api.fptcloud.com
